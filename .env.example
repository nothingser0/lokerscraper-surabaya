# Notification Credentials
# Single Discord webhook (backward compatible). Leave empty if using
# DISCORD_WEBHOOK_URLS below.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook/url
# Multiple Discord webhooks (comma-separated). Notifications are sent to every
# URL in this list. Takes precedence over DISCORD_WEBHOOK_URL when set.
DISCORD_WEBHOOK_URLS=
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-100123456789

# Translation (DeepL) - optionally translate job descriptions to Bahasa Indonesia.
# Translation is opt-in: leave DEEPL_API_KEY empty to keep descriptions in their
# original language (no translation). Set a key to enable full Bahasa Indonesia
# translation via DeepL.
# Free tier uses https://api-free.deepl.com/v2/translate (Pro: https://api.deepl.com/v2/translate)
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# Scheduler Configs
# Fixed scrape interval in hours (used when no random range is configured).
SCRAPE_INTERVAL_HOURS=6
# Optional: random scrape interval. When both are set and MAX > MIN, each cycle
# is scheduled with a random delay between MIN and MAX hours (e.g. 4-8h).
# Leave both 0 to use the fixed SCRAPE_INTERVAL_HOURS above.
SCRAPE_INTERVAL_MIN_HOURS=0
SCRAPE_INTERVAL_MAX_HOURS=0

# Optional: protect the manual trigger endpoint (POST /api/trigger)
# Leave empty to allow unauthenticated trigger. Set to a secret to require
# the header "X-Trigger-Token: <value>".
TRIGGER_TOKEN=

# Filters (Comma separated)
IT_KEYWORDS=developer,engineer,programmer,backend,frontend,fullstack,mobile,data,devops,qa,tester,web
LOCATIONS=surabaya,sidoarjo,gresik,remote
