# ==============================================================================
# LOKERSCRAPER SURABAYA - ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- Notification Channels ---
# Discord single webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Discord multi-webhook URLs (comma-separated, takes precedence if set)
# DISCORD_WEBHOOK_URLS=https://discord.com/api/webhooks/aaa/bbb,https://discord.com/api/webhooks/ccc/ddd

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Translation (DeepL - Optional) ---
# Leave empty to keep job descriptions in their original language.
# Free: https://api-free.deepl.com/v2/translate | Pro: https://api.deepl.com/v2/translate
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate

# --- Scraping & Scheduling ---
# Fixed interval in hours (default: 6)
SCRAPE_INTERVAL_HOURS=6

# Optional: Random interval range in hours.
# When MAX > MIN, each cycle uses a random delay between MIN and MAX. Set both to 0 to disable.
SCRAPE_INTERVAL_MIN_HOURS=3
SCRAPE_INTERVAL_MAX_HOURS=6

# Optional: Token to protect POST /api/trigger endpoint (header X-Trigger-Token: <token>)
TRIGGER_TOKEN=your_secure_trigger_token_here

# --- Optional Cloudflare Tunnel ---
# Set your Cloudflare Zero Trust tunnel token to expose the dashboard publicly via your domain
# Leave empty if using local access, reverse proxy, or VPN (e.g. Tailscale).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Search Target & Filtering (Comma-separated) ---
# Keywords matched against job titles (case-insensitive)
KEYWORDS=developer,engineer,programmer,backend,frontend,fullstack,mobile,data,devops,qa,tester,web,quality assurance,software

# Locations or work modes matched against job locations (case-insensitive)
LOCATIONS=surabaya,sidoarjo,gresik,remote
