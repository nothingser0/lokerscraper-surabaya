[Unit]
Description=LokerScraper Surabaya Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/lokerscraper-surabaya
ExecStart=%h/lokerscraper-surabaya/lokerscraper
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=%h/lokerscraper-surabaya/.env
Restart=always
RestartSec=10
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
